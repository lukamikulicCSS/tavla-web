# ─────────────────────────────────────────────────────────────
# TAVLA web — varijable okruženja
# Kopiraj u .env.local (lokalno) ili upiši u Cloudflare → Workers & Pages → tavla-web → Settings.
# NIŠTA s prefiksom NEXT_PUBLIC_ nije tajna — to vidi preglednik.
# ─────────────────────────────────────────────────────────────

# Javni URL stranice (canonical, sitemap, Open Graph). Bez kose crte na kraju.
NEXT_PUBLIC_SITE_URL=https://tavlahr.com

# ── Kontakt forma (Resend — https://resend.com) ── TAJNO
RESEND_API_KEY=
# Kamo stižu upiti
CONTACT_TO_EMAIL=
# Pošiljatelj — mora biti na domeni verificiranoj u Resendu, npr. "Tavla <web@tavlahr.com>"
CONTACT_FROM_EMAIL=

# ── Rate limiting preko Upstash Redisa (preporučeno u produkciji) ── TAJNO
# Bez ovoga radi ograničenje u memoriji (dovoljno za start, ali po instanci).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare Turnstile (neobavezna zaštita od spama) ──
# Ako su prazne, forma koristi honeypot + vremensku zamku + rate limit.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analitika koja poštuje privatnost (Plausible ili Umami) ──
# Učitava se TEK nakon pristanka na analitičke kolačiće.
# Plausible primjer: NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Samo za Umami: website ID
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=

# ── Newsletter (double opt-in preko Resenda) ── TAJNO
# Audience (popis primatelja) iz Resend dashboarda → Audiences
RESEND_AUDIENCE_ID=
# Nasumičan niz od min. 32 znaka za potpis tokena potvrde i odjave.
# Generiranje: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEWSLETTER_TOKEN_SECRET=
# Pošiljatelj potvrdnih mailova (domena mora biti potvrđena u Resendu)
NEWSLETTER_FROM_EMAIL=Tavla <novosti@tavlahr.com>

# ── KPI ploča /admin/kpi (Cloudflare Access) ──
# Team domena iz Zero Trust → Settings → Custom Pages, npr. tavla.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# "Application Audience (AUD) Tag" aplikacije u Zero Trust → Access → Applications
CF_ACCESS_AUD=
# Zarezom odvojene adrese koje smiju vidjeti ploču (dodatna provjera uz Access politiku)
ADMIN_EMAILS=lmikulic@tavlahr.com,aspajic@tavlahr.com

# ── Analitika ──
# Vlastita analitika koristi D1 binding "DB" (wrangler.jsonc), ne varijable.
# Rok čuvanja sirovih događaja postavljen je u wrangler.jsonc → vars.ANALYTICS_RETENTION_DAYS
