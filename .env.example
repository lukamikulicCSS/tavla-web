# ─────────────────────────────────────────────────────────────
# TAVLA web — varijable okruženja
# Kopiraj u .env.local (lokalno) ili upiši u Cloudflare → Workers & Pages → tavla-web → Settings.
# NIŠTA s prefiksom NEXT_PUBLIC_ nije tajna — to vidi preglednik.
# ─────────────────────────────────────────────────────────────

# Javni URL stranice (canonical, sitemap, Open Graph). Bez kose crte na kraju.
NEXT_PUBLIC_SITE_URL=https://tavlahr.com

# ── Kontakt forma (Resend — https://resend.com) ── TAJNO
RESEND_API_KEY=
# Kamo stižu upiti
CONTACT_TO_EMAIL=
# Pošiljatelj — mora biti na domeni verificiranoj u Resendu, npr. "Tavla <web@tavlahr.com>"
CONTACT_FROM_EMAIL=

# ── Rate limiting preko Upstash Redisa (preporučeno u produkciji) ── TAJNO
# Bez ovoga radi ograničenje u memoriji (dovoljno za start, ali po instanci).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare Turnstile (neobavezna zaštita od spama) ──
# Ako su prazne, forma koristi honeypot + vremensku zamku + rate limit.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analitika koja poštuje privatnost (Plausible ili Umami) ──
# Učitava se TEK nakon pristanka na analitičke kolačiće.
# Plausible primjer: NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Samo za Umami: website ID
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
