{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tavla-web",
  // worker.ts omata OpenNext worker i dodaje Cron (brisanje starih analitičkih događaja)
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tavla-web"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Analitika, newsletter i upiti. database_id se dobije naredbom:
  //   npx wrangler d1 create tavla-web
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tavla-web",
      "database_id": "b0357e4b-4d1b-4576-aefd-45cded935c66",
      "migrations_dir": "migrations"
    }
  ],
  // Svaki dan u 03:15 UTC: dnevni zbirni podaci + brisanje sirovih događaja starijih od roka čuvanja
  "triggers": {
    "crons": ["15 3 * * *"]
  },
  "vars": {
    // Rok čuvanja sirovih analitičkih događaja u danima (13 mjeseci). Zbirni dnevni podaci ostaju.
    "ANALYTICS_RETENTION_DAYS": "395"
  },
  "observability": {
    "enabled": true
  }
}
